{
  "name": "logarithmic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run fmt && pnpm run lint:fix",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "ready": "pnpm run check && pnpm run test && pnpm run build",
    "dev": "pnpm --filter logarithmic-backend --filter logarithmic-frontend --parallel run dev"
  },
  "dependencies": {
    "@playwright/cli": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
